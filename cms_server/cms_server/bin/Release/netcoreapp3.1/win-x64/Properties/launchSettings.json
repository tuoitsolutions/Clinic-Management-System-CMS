      }
    },
    "DeliveryRoomWatcher": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "api/start",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "https://localhost:44302"
    }
  }
}